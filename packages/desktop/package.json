{
  "name": "@lootden/desktop",
  "version": "0.37.0",
  "private": true,
  "description": "LootDen desktop app for Windows and Linux (x64 and ARM)",
  "homepage": "https://github.com/Spacegoose02/lootden",
  "author": {
    "name": "Spacegoose02",
    "email": "208424520+Spacegoose02@users.noreply.github.com"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node ../../scripts/brand.mjs && tsc -p . && node scripts/bundle.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never && electron-builder --linux --arm64 --publish never '-c.appImage.artifactName=LootDen-linux-arm64-${version}.${ext}'"
  },
  "dependencies": {
    "@lootden/client": "0.37.0"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "io.github.gamemanager.desktop",
    "productName": "LootDen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "setup/**",
      "build/icon.png",
      "build/mascot.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/7zip/${os}/${arch}",
        "to": "7zip",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "LootDen",
        "schemes": [
          "lootden",
          "gamemanager"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "LootDen"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "LootDen-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "mimeTypes": [
        "x-scheme-handler/lootden",
        "x-scheme-handler/gamemanager"
      ],
      "executableName": "lootden",
      "maintainer": "Spacegoose02 <208424520+Spacegoose02@users.noreply.github.com>"
    },
    "artifactName": "LootDen-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "portable": {
      "artifactName": "LootDen-${version}-portable.${ext}"
    }
  }
}
