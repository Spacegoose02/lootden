{
  "name": "lootden",
  "version": "0.24.0",
  "private": true,
  "description": "Self-hosted library for DRM-free games: a Docker server that serves the library and clients that download, unpack and install games.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/web",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/server packages/client && npm run build -w @lootden/web",
    "clean": "tsc -b --clean packages/shared packages/server packages/client",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"packages/*/dist/test/**/*.test.js\"",
    "dev:server": "npm run build && node --disable-warning=ExperimentalWarning packages/server/dist/src/index.js",
    "lootden": "node packages/client/dist/src/cli.js",
    "gm": "node packages/client/dist/src/cli.js",
    "dev:web": "npm run dev -w @lootden/web",
    "build:desktop": "npm run build -w @lootden/desktop",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
